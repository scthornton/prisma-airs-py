# Copy to .env (gitignored) or export these in your shell.
# Credentials are also read from ~/.prisma-airs/config.json -- see `airs config path`.

# --- Runtime scanning -------------------------------------------------------
# API key for the AI Runtime Security scan API.
PANW_AI_SEC_API_KEY=

# Optional. Regional scan endpoint: us (default), de, in, sg.
# PANW_AI_SEC_REGION=us

# --- Management plane -------------------------------------------------------
# OAuth2 service account from Strata Cloud Manager
# (Identity & Access -> Service Accounts). Drives the management, AI gateway,
# red team, and model security clients unless a service-specific prefix is set.
PANW_MGMT_CLIENT_ID=
PANW_MGMT_CLIENT_SECRET=
PANW_MGMT_TSG_ID=

# --- Optional per-service overrides -----------------------------------------
# Each falls back to the PANW_MGMT_* values above when unset.
# PANW_RED_TEAM_CLIENT_ID=
# PANW_RED_TEAM_CLIENT_SECRET=
# PANW_RED_TEAM_TSG_ID=
# PANW_AI_GW_CLIENT_ID=
# PANW_AI_GW_CLIENT_SECRET=
# PANW_AI_GW_TSG_ID=
# PANW_MODEL_SEC_CLIENT_ID=
# PANW_MODEL_SEC_CLIENT_SECRET=
# PANW_MODEL_SEC_TSG_ID=

# --- Diagnostics ------------------------------------------------------------
# Set to 1 to log requests and responses. Secrets are redacted.
# PANW_AI_SEC_DEBUG=0
